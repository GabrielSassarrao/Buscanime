{
  "expo": {
    "name": "Buscanime",
    "slug": "buscanime",
    "version": "2.4.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1A2F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gabriel.buscanime"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0A1A2F"
      },
      "package": "com.gabriel.buscanime"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "buscanime",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5bb312b7-1429-4ecb-9e8b-2aff59fdcd70"
      }
    }
  }
}